# Safe local development defaults. Keep MOCK_MODE=true unless you have completed
# a separate operational review and explicitly intend to send transactions.
MOCK_MODE=true

# Agent identity -- required only when MOCK_MODE=false. Never commit this value.
PRIVATE_KEY=
BASE_RPC_URL=

# Runtime Configuration
MIN_CONFIDENCE=0.75
POLL_INTERVAL=60
BET_AMOUNT_USDC=0.5
INITIAL_DEPOSIT_USDC=0.5

# LLM Provider
OPENAI_API_KEY=

TAVILY_API_KEY=

# Database
DATABASE_URL=sqlite:///./data/agent.db

# Protocol/API connection -- set this only in a private runtime environment.
DIALECTICA_API_URL=

# Contract and protocol identifiers -- required only when MOCK_MODE=false.
USDC_ADDRESS=
CLAIMS_ADDRESS=
TREASURY_ADDRESS=
COLLECTIONS_ADDRESS=
ROUNDS_ADDRESS=

# Optional alerting. Treat webhook URLs as secrets.
SLACK_WEBHOOK_URL=

# Required only when MOCK_MODE=false if vote encryption is enabled.
DIALECTICA_PUBLIC_KEY=
